# web-app environment variables (example)
# Copy to .env.local for local development.
# In Vercel, set these in Project Settings -> Environment Variables.

# Error message verbosity:
# - user: end-user friendly (recommended)
# - debug: includes more diagnostic details
NEXT_PUBLIC_ERROR_MESSAGE_LEVEL=user

# UI locale hint:
# - ja / en
# If unset, the app falls back to navigator.language, then 'ja'.
NEXT_PUBLIC_LOCALE=ja
