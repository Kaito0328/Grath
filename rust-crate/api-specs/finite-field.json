          "doc": "Create GF(2^m) with modulus given as coefficients over GF(2) (low->high), length m+1.\nExample: for AES GF(2^8), px = [1,1,0,1,1,0,0,0,1] for x^8 + x^4 + x^3 + x + 1.",
          "source_code": "# [doc = \" Create GF(2^m) with modulus given as coefficients over GF(2) (low->high), length m+1.\"] # [doc = \" Example: for AES GF(2^8), px = [1,1,0,1,1,0,0,0,1] for x^8 + x^4 + x^3 + x + 1.\"] pub fn new (px : & [GFp < 2 >]) -> Self { assert ! (! px . is_empty () , \"px empty\") ; let m = px . len () - 1 ; assert ! (m <= 15 , \"m too large for u16 element: {}\" , m) ; assert ! (px [m] . 0 == 1 , \"leading coeff must be 1\") ; assert ! (px [0] . 0 == 1 , \"constant coeff should be 1 for primitive polynomials (usual)\") ; let mut bits : u32 = 0 ; for (i , c) in px . iter () . enumerate () { if c . 0 != 0 { bits |= 1u32 << i ; } } let (exp , log) = build_tables (m , bits) ; Self { m , n : (1usize << m) - 1 , px_bits : bits , exp , log , } }",
