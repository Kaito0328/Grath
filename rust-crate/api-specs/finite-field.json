          "source_code": "# [doc = \" Minimal polynomial of alpha^i over GF(2) via Frobenius orbit product ∏ (X - α^{i·2^k}).\"] pub fn minimal_polynomial_over_gf2 (& self , i : usize) -> Poly < GFp < 2 > > { let coset = self . cyclotomic_coset (i % self . n) ; let mut coeffs : Vec < u16 > = vec ! [1] ; for & e in & coset { let r = self . alpha_pow (e) ; let d = coeffs . len () - 1 ; let mut next = vec ! [0u16 ; coeffs . len () + 1] ; next [0] = self . mul (coeffs [0] , r) ; for k in 1 ..= d { next [k] = self . add (coeffs [k - 1] , self . mul (coeffs [k] , r)) ; } next [d + 1] = coeffs [d] ; coeffs = next ; } let mut out : Vec < GFp < 2 > > = Vec :: with_capacity (coeffs . len ()) ; for c in coeffs { match c { 0 => out . push (GFp :: < 2 > (0)) , 1 => out . push (GFp :: < 2 > (1)) , _ => panic ! (\"minimal polynomial has non-binary coefficient: {c}\") , } } Poly :: new (out) }",
